<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Задачи"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FF10B981"
        android:layout_marginBottom="5dp"/>

    <!-- Прогресс-бар -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF10B981"
        android:progressBackgroundTint="#1A10B981"
        android:layout_marginBottom="8dp"/>

    <!-- Пустое состояние -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Нет предстоящих задач"
        android:textSize="12sp"
        android:textColor="#FF8E8E93"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- Строка 1 -->
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/check1" android:layout_width="22dp" android:layout_height="22dp" android:text="○" android:textSize="15sp" android:textColor="#FF10B981" android:gravity="center" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#FF1D1D1F" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/time1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FF10B981" android:textStyle="bold" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Строка 2 -->
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/check2" android:layout_width="22dp" android:layout_height="22dp" android:text="○" android:textSize="15sp" android:textColor="#FF10B981" android:gravity="center" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#FF1D1D1F" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/time2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FF10B981" android:textStyle="bold" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Строка 3 -->
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/check3" android:layout_width="22dp" android:layout_height="22dp" android:text="○" android:textSize="15sp" android:textColor="#FF10B981" android:gravity="center" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#FF1D1D1F" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/time3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FF10B981" android:textStyle="bold" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Строка 4 -->
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/check4" android:layout_width="22dp" android:layout_height="22dp" android:text="○" android:textSize="15sp" android:textColor="#FF10B981" android:gravity="center" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/title4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#FF1D1D1F" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/time4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FF10B981" android:textStyle="bold" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Строка 5 -->
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/check5" android:layout_width="22dp" android:layout_height="22dp" android:text="○" android:textSize="15sp" android:textColor="#FF10B981" android:gravity="center" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/title5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#FF1D1D1F" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/time5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FF10B981" android:textStyle="bold" android:layout_marginStart="6dp"/>
    </LinearLayout>

</LinearLayout>
